# ==============================================================================
# CyberXAI Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hugging Face Hub Authentication
# Required for downloading model checkpoints & uploading trained artifacts to HF Hub
# Repo: https://huggingface.co/siddudavant/cyberxai-models
# Obtain token: https://huggingface.co/settings/tokens (Write permissions required for upload)
# ------------------------------------------------------------------------------
HF_TOKEN=your_huggingface_write_token_here

# ------------------------------------------------------------------------------
# 2. Google Gemini API Authentication
# Powers the interactive AI Security Analyst Assistant (/api/chat)
# Obtain key: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Abuse.ch ThreatFox / URLhaus Intelligence Authentication
# Used for real-time live threat index lookups & fresh IOC sample streaming
# Obtain key: https://auth.abuse.ch/
# ------------------------------------------------------------------------------
ABUSE_CH_AUTH_KEY=your_abuse_ch_auth_key_here

# ------------------------------------------------------------------------------
# 4. Kaggle GPU Compute & Model Training Rotation
# Used for launching headless training runs on Kaggle P100 / T4 GPUs
# Obtain token: https://www.kaggle.com/settings -> "Create New Token"
# ------------------------------------------------------------------------------
KAGGLE_API_TOKEN=your_primary_kaggle_api_token_here
KAGGLE_API_TOKEN_1=your_kaggle_token_account_1_here
KAGGLE_API_TOKEN_2=your_kaggle_token_account_2_here
KAGGLE_API_TOKEN_3=your_kaggle_token_account_3_here
